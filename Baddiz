			local Text = TextBox.Text

			if #Text ~= 4 then
				TextLabel2.Text = "PIN must be 4 digits."

				return
			end

			TextLabel2.TextColor3 = Color3.fromRGB(160, 160, 180)
			TextLabel2.Text = "Checking..."

